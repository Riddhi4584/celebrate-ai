# CelebrateAI Environment Configuration
# Optional: External LLM API Keys
# If left blank, CelebrateAI automatically operates using its built-in
# Intelligent Contextual Demo AI Engine with customized deterministic event planning.

# Google Gemini API Key (e.g. AIzaSy...)
VITE_GEMINI_API_KEY=

# OpenAI API Key (e.g. sk-...)
VITE_OPENAI_API_KEY=

# Default Currency (INR, USD, EUR, GBP)
VITE_DEFAULT_CURRENCY=INR

# Port for local dev server
VITE_PORT=5173
